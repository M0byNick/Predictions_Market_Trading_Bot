# --- Kalshi (RSA-PSS, 2048-bit) ---
KALSHI_ACCESS_KEY=your-kalshi-uuid-key-id
KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi.pem
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

# --- Polymarket Global (Polygon CLOB) ---
# Read-only ingest needs NO auth. Wallet only required for live order placement.
# Operator must be in a Polymarket-supported jurisdiction (most of EU including
# Ireland, Brazil, etc. — NOT the US).
POLY_GLOBAL_GAMMA_URL=https://gamma-api.polymarket.com
POLY_GLOBAL_CLOB_URL=https://clob.polymarket.com
POLY_GLOBAL_RATE_PER_SEC=8.0
# Live-trading-only: 0x-prefixed Polygon private key. Leave empty for paper v1.
POLY_WALLET_PRIVATE_KEY=

# --- Anthropic (LLM pair adjudicator) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Bot ---
MODE=paper
DATA_DIR=/app/data
HEARTBEAT_PATH=/app/data/.heartbeat
INGEST_INTERVAL_SEC=60
DASHBOARD_PORT=8090

# --- Bankroll-driven risk (paper) ---
# Set INITIAL_BANKROLL_USD to your starting capital — every dollar limit
# scales linearly from this. Same code works at $1K paper, $1K live, or
# $5K+ live without touching individual caps.
INITIAL_BANKROLL_USD=1000           # bankroll target (USD across both venues)
PAPER_MAX_POSITION_PCT=0.10         # hard cap: max 10% of bankroll per arb
PAPER_PER_PAIR_TARGET_PCT=0.05      # target: 5% of bankroll per arb position
PAPER_MIN_POSITION_USD=25           # below this, slippage eats the trade — skip
PAPER_DAILY_MAX_LOSS_PCT=0.05       # daily stop at 5% of bankroll
PAPER_MIN_EDGE_BPS=200              # require >= 2% edge AFTER fees to trade
# Computed from above (for reference, not env-set):
#   max_position_usd      = INITIAL_BANKROLL_USD * PAPER_MAX_POSITION_PCT
#   per_pair_target_usd   = INITIAL_BANKROLL_USD * PAPER_PER_PAIR_TARGET_PCT
#   daily_max_loss_usd    = INITIAL_BANKROLL_USD * PAPER_DAILY_MAX_LOSS_PCT

# --- Mapping ---
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_COSINE_THRESHOLD=0.75
CANDIDATE_TOP_K=5

# --- Ingest filters ---
# Kalshi has 750K+ active markets, most stale. Tight default keeps ~5K liquid.
KALSHI_MIN_VOLUME=10000
POLY_GLOBAL_MIN_VOLUME=10000
# Set true to store the full venue raw JSON per market (debugging only; +90% DB size)
STORE_RAW_JSON=false
