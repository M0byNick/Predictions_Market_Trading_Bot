# --- Kalshi ---
KALSHI_ACCESS_KEY=your-kalshi-uuid-key-id
KALSHI_PRIVATE_KEY_PATH=/app/secrets/kalshi.pem
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

# --- Polymarket US (CFTC-regulated via QCEX) ---
POLY_US_ACCESS_KEY=your-polymarket-us-key-id
POLY_US_SECRET_KEY=your-base64-ed25519-secret
POLY_US_BASE_URL=https://api.polymarket.us/v1

# --- Polymarket Global (read-only reference feed; public, no auth) ---
POLY_GLOBAL_GAMMA_URL=https://gamma-api.polymarket.com
POLY_GLOBAL_CLOB_URL=https://clob.polymarket.com

# --- Anthropic (LLM adjudicator) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Bot ---
MODE=paper
DATA_DIR=/app/data
HEARTBEAT_PATH=/app/data/.heartbeat
INGEST_INTERVAL_SEC=60
DASHBOARD_PORT=8090

# --- Risk (paper) ---
PAPER_MAX_POSITION_USD=500
PAPER_DAILY_MAX_LOSS_USD=100
PAPER_MIN_EDGE_BPS=200          # require >= 2% edge AFTER fees to trade on paper

# --- Mapping ---
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_COSINE_THRESHOLD=0.75
CANDIDATE_TOP_K=5
